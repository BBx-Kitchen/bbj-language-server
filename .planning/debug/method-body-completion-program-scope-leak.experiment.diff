+                currentNode = currentNode.$container;
+            } while (currentNode);
+        }
+        let result = this.getGlobalScope(referenceType, context);
+        for (let i = scopes.length - 1; i >= 0; i--) {
+            result = this.createScope(scopes[i], result);
