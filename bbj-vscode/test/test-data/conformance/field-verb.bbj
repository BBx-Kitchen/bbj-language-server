REM Protects the FIELD verb -- record, name and value are plain expressions -- from
REM being swallowed by the bare-identifier fallback that has nowhere to put the
REM following comma. Covers the name-part shapes (a string variable, a spaced
REM string literal, and a masked concatenation), the value-part shapes (a nested
REM call, a negative number, NUM(), and a method-call result), upper/lower/mixed
REM case, a verb chained after a label on the same line, and the untouched
REM class-member FIELD declaration that shares the same keyword.
CLASS PUBLIC HolderRecord
FIELD PUBLIC INTEGER COUNT
METHOD PUBLIC STRING GETNAME()
METHODRET "SAMPLE"
METHODEND
CLASSEND
DECLARE HolderRecord HOLDER!
HOLDER!=NEW HolderRecord()
REC$=""
NAME$=""
N=1
FIELD REC$,NAME$=DEC(N)
FIELD REC$, "STATICNAME" = "MARY"
FIELD REC$,"PRE_"+STR(N:"00") = CVS(REC$,3)
FIELD REC$,NAME$=DEC(STR(N))
FIELD REC$,NAME$=-5
FIELD REC$,NAME$=NUM(NAME$)
FIELD REC$,NAME$=HOLDER!.GETNAME()
field rec$,name$=1
Field Rec$,Name$=1
LBL:FIELD REC$,NAME$=1
